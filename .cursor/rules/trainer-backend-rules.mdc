example/
├── lib/
│   ├── main.dart                    # Entry point with routing
│   ├── auth_test.screen.dart        # Tests AuthService methods
│   ├── programs_test.screen.dart    # Tests ProgramsService methods
│   ├── sessions_test.screen.dart    # Tests SessionsService methods
